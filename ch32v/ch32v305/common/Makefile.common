# ============================================================
# Makefile.common — Reglas compartidas para CH32V305
# Incluir desde cada proyecto con: include ../../common/Makefile.common
# ============================================================

COMMON   = ../../common

# Toolchain
PREFIX   = riscv-none-elf-
CC       = $(PREFIX)gcc
OBJCOPY  = $(PREFIX)objcopy
OBJDUMP  = $(PREFIX)objdump
SIZE     = $(PREFIX)size

# WCH OpenOCD
OPENOCD  = /opt/wch-openocd/bin/openocd
OCD_CFG  = /opt/wch-openocd/bin/wch-riscv.cfg

# CPU flags for CH32V305 (QingKe V4F = rv32imac + FPU optional)
ARCH     = -march=rv32imac_zicsr -mabi=ilp32

CFLAGS  += $(ARCH) -Os -Wall -g \
           -I$(COMMON) \
           -ffunction-sections -fdata-sections -nostdlib

LDFLAGS += $(ARCH) -T $(COMMON)/ch32v305.ld -nostdlib -Wl,--gc-sections \
           -Wl,-Map=$(BUILD)/$(TARGET).map

COMMON_S = $(COMMON)/startup.S

OBJS     = $(addprefix $(BUILD)/, $(SRCS_C:.c=.o) $(SRCS_S:.S=.o)) \
           $(BUILD)/startup.o

BUILD   ?= build

.PHONY: all clean flash erase

all: $(BUILD)/$(TARGET).elf $(BUILD)/$(TARGET).hex $(BUILD)/$(TARGET).bin
	@$(SIZE) $(BUILD)/$(TARGET).elf

$(BUILD)/%.o: %.c | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%.o: %.S | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/startup.o: $(COMMON_S) | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/$(TARGET).elf: $(OBJS)
	$(CC) $(LDFLAGS) $^ -o $@
	$(OBJDUMP) -d $@ > $(BUILD)/$(TARGET).lst

$(BUILD)/$(TARGET).hex: $(BUILD)/$(TARGET).elf
	$(OBJCOPY) -O ihex $< $@

$(BUILD)/$(TARGET).bin: $(BUILD)/$(TARGET).elf
	$(OBJCOPY) -O binary $< $@

$(BUILD):
	mkdir -p $(BUILD)

flash: $(BUILD)/$(TARGET).elf
	$(OPENOCD) -f $(OCD_CFG) \
	  -c "init" \
	  -c "halt" \
	  -c "program $(BUILD)/$(TARGET).elf verify" \
	  -c "reset" \
	  -c "exit"

erase:
	$(OPENOCD) -f $(OCD_CFG) \
	  -c "init" \
	  -c "halt" \
	  -c "flash erase_sector wch_riscv.flash 0 last" \
	  -c "exit"

clean:
	rm -rf $(BUILD)
